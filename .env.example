# Local / development (default) — SQLite
# Full guide: docs/LOCAL_DEVELOPMENT.md
ADO2GH_STORAGE_BACKEND=sqlite
ADO2GH_SQLITE_PATH=./migration_state.db
ADO2GH_DATA_DIR=./data

# Production — PostgreSQL (use with docker-compose.prod.yml)
# ADO2GH_STORAGE_BACKEND=postgres
# ADO2GH_DATABASE_URL=postgresql://ado2gh:ado2gh@localhost:5432/ado2gh

# Azure DevOps / GitHub credentials
ADO_ORG_URL=
ADO_PAT=
GH_TOKEN=

# Local IDE agent (specs/003-local-agent-ide)
LLM_PROVIDER=stub
ADO2GH_LLM_BACKEND=stub
# Cloud LLM backends (optional — or configure via Settings → LLM models)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=github_copilot
# GITHUB_TOKEN=           # PAT with models:read (or reuse GH_TOKEN)
# GITHUB_MODEL=openai/gpt-4o
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o

# Platform-supplied / ambient cloud LLM (007)
# Copy to .env and fill in values. Docker Compose reads .env automatically.
# Required on accelerator + agent at container START (not via docker exec).
# Then: Settings → Cloud credentials → Rescan → Approve → validate platform model.
# Secrets are never stored by the app — only presence is detected; admin approves use.
#
# AWS Bedrock (access-key path — or use EC2 instance profile and omit keys below)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# ADO2GH_BEDROCK_MODEL_ID=

# Optional session token (STS / assumed role)
# AWS_SESSION_TOKEN=
#
# Microsoft Foundry (service principal — secret via host env, not stored in app)
# ADO2GH_FOUNDRY_MODEL_ID=
# ADO2GH_FOUNDRY_ENDPOINT=
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
#
# Google Vertex (ADC file path or GCE metadata — not stored in app)
# ADO2GH_VERTEX_MODEL_ID=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/on/host/to/service-account.json

ADO2GH_LIGHTWEIGHT_MODE=true
ADO2GH_AUTH_ENABLED=false
ADO2GH_LOCAL_PROFILE=lightweight
ACCELERATOR_URL=http://localhost:8080
# ADO2GH_SESSION_COOKIE=  # prod-like auth forwarding

# Shared secret for the agent's /v1/internal/ routes, which the accelerator uses to
# resume or deny a live migration. These routes carry no operator session cookie, so
# leaving this unset makes the live-migration approval gate reachable unauthenticated.
# Set the SAME value on the accelerator and the agent in any shared environment.
# ADO2GH_INTERNAL_TOKEN=
# Failed logins per username before a temporary lockout, and the lockout window.
ADO2GH_LOGIN_MAX_ATTEMPTS=5
ADO2GH_LOGIN_LOCKOUT_SECONDS=300

# Agent observability (optional — LangSmith traces graph nodes when enabled)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ado2gh-migration-agent
