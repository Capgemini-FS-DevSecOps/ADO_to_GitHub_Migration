# Local / development (default) — SQLite
ADO2GH_STORAGE_BACKEND=sqlite
ADO2GH_SQLITE_PATH=./migration_state.db

# Production — PostgreSQL (use with docker-compose.prod.yml)
# ADO2GH_STORAGE_BACKEND=postgres
# ADO2GH_DATABASE_URL=postgresql://ado2gh:ado2gh@localhost:5432/ado2gh

# Serverless production — DynamoDB (use with docker-compose.serverless.yml)
# ADO2GH_STORAGE_BACKEND=dynamodb
# ADO2GH_DYNAMODB_TABLE=ado2gh-state
# ADO2GH_DYNAMODB_JOBS_TABLE=ado2gh-jobs
# ADO2GH_DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_REGION=us-east-1

# Azure DevOps / GitHub credentials
ADO_ORG_URL=
ADO_PAT=
GH_TOKEN=

# Local IDE agent (specs/003-local-agent-ide)
LLM_PROVIDER=stub
ADO2GH_LLM_BACKEND=stub
ADO2GH_LIGHTWEIGHT_MODE=true
ADO2GH_AUTH_ENABLED=false
ADO2GH_LOCAL_PROFILE=lightweight
ACCELERATOR_URL=http://localhost:8080
# ADO2GH_SESSION_COOKIE=  # prod-like auth forwarding
