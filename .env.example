# Local / development (default) — SQLite
# Full guide: docs/LOCAL_DEVELOPMENT.md
ADO2GH_STORAGE_BACKEND=sqlite
ADO2GH_SQLITE_PATH=./migration_state.db
ADO2GH_DATA_DIR=./data

# Production — PostgreSQL (use with docker-compose.prod.yml)
# ADO2GH_STORAGE_BACKEND=postgres
# REQUIRED by docker-compose.prod.yml: it starts Postgres with this password and
# builds ADO2GH_DATABASE_URL from it, with no default, so an unset value stops the
# stack rather than bringing up a guessable database.
# POSTGRES_PASSWORD=
# ADO2GH_DATABASE_URL=postgresql://ado2gh:${POSTGRES_PASSWORD}@localhost:5432/ado2gh

# Production — DynamoDB job queue (the job store only; there is no DynamoDB
# state database, which is why the audit destination below must be named)
# ADO2GH_STORAGE_BACKEND=dynamodb
# Table holding the migration jobs; create it before starting a worker.
# ADO2GH_DYNAMODB_TABLE=ado2gh
# ADO2GH_DYNAMODB_JOBS_TABLE=ado2gh-jobs
# Point at a DynamoDB running on this machine instead of the real service.
# ADO2GH_DYNAMODB_ENDPOINT=http://localhost:8000
# SQLite file holding the job queue when no backend is configured.
# ADO2GH_JOB_DB=./migration_jobs.db

# Where audit events are written. `state` (or leaving this unset) keeps them in
# the state database above. A deployment whose state backend cannot hold them —
# a DynamoDB job store has no state database at all — names another place, and
# the job worker refuses to start until it does.
# Accepted: state | dynamodb://<table-name> | sqlite://<file-path> |
#           postgres://... | postgresql://...
# The DynamoDB table is never created here; create it first with `id` as the
# partition key. The AWS region comes from AWS_REGION / AWS_DEFAULT_REGION.
ADO2GH_AUDIT_DESTINATION=state

# Azure DevOps / GitHub credentials
ADO_ORG_URL=
ADO_PAT=
GH_TOKEN=

# Local IDE agent (specs/003-local-agent-ide)
LLM_PROVIDER=stub
ADO2GH_LLM_BACKEND=stub
# Cloud LLM backends (optional — or configure via Settings → LLM models)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=github_copilot
# GITHUB_TOKEN=           # PAT with models:read (or reuse GH_TOKEN)
# GITHUB_MODEL=openai/gpt-4o
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o

# Platform-supplied / ambient cloud LLM (007)
# Copy to .env and fill in values. Docker Compose reads .env automatically.
# Required on accelerator + agent at container START (not via docker exec).
# Then: Settings → Cloud credentials → Rescan → Approve → validate platform model.
# Secrets are never stored by the app — only presence is detected; admin approves use.
#
# AWS Bedrock (access-key path — or use EC2 instance profile and omit keys below)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# ADO2GH_BEDROCK_MODEL_ID=

# Optional session token (STS / assumed role)
# AWS_SESSION_TOKEN=
#
# Microsoft Foundry (service principal — secret via host env, not stored in app)
# ADO2GH_FOUNDRY_MODEL_ID=
# ADO2GH_FOUNDRY_ENDPOINT=
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
#
# Google Vertex (ADC file path or GCE metadata — not stored in app)
# ADO2GH_VERTEX_MODEL_ID=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/on/host/to/service-account.json

ADO2GH_LIGHTWEIGHT_MODE=true
ADO2GH_AUTH_ENABLED=false
ADO2GH_LOCAL_PROFILE=lightweight
ACCELERATOR_URL=http://localhost:8080
# ADO2GH_SESSION_COOKIE=  # prod-like auth forwarding

# Shared secret for the agent's /v1/internal/ routes, which the accelerator uses to
# resume or deny a live migration. These routes carry no operator session cookie, so
# the agent guards them with this token instead and fails closed.
# REQUIRED whenever ADO2GH_AUTH_ENABLED=true — unset or mismatched, the agent answers
# 401 and live-migration approvals never resume. Set the SAME value on BOTH the
# accelerator and the agent; a value on only one side fails at runtime. Ignored while
# ADO2GH_AUTH_ENABLED=false (the agent skips /v1/ auth entirely).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# ADO2GH_INTERNAL_TOKEN=
# Failed logins per username before a temporary lockout, and the lockout window.
ADO2GH_LOGIN_MAX_ATTEMPTS=5
ADO2GH_LOGIN_LOCKOUT_SECONDS=300

# Set to true ONLY when a reverse proxy you control terminates TLS in front of the
# accelerator. It makes the session cookie's Secure flag follow the LAST element of
# X-Forwarded-Proto (or RFC 7239 Forwarded) — the hop that proxy wrote. Left false,
# forwarding headers are ignored and the transport the request arrived on decides, so
# no client can strip Secure off its own session cookie by sending a header.
ADO2GH_TRUSTED_PROXY=false

# Agent observability (optional — LangSmith traces graph nodes when enabled)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ado2gh-migration-agent
