# Copy to secret.yaml and replace values. Do not commit real secrets.
apiVersion: v1
kind: Secret
metadata:
  name: ado2gh-secrets
  namespace: ado2gh
type: Opaque
stringData:
  ADO2GH_SESSION_SECRET: replace-with-32-byte-hex-secret
  POSTGRES_PASSWORD: replace-with-strong-password
  # Shared secret for the agent's /v1/internal/ live-approval routes, which carry no
  # operator session cookie. Required because configmap.yaml sets
  # ADO2GH_AUTH_ENABLED: "true" — without it the agent 401s the accelerator's
  # resume-live/deny-live calls. Belongs here, not in the ConfigMap. Both the
  # accelerator and agent Deployments envFrom this Secret, so one entry reaches both;
  # they must see the same value.
  ADO2GH_INTERNAL_TOKEN: replace-with-32-byte-hex-secret
