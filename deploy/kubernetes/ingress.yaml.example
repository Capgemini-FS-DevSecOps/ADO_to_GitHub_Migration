# Optional — adjust host and TLS for your cluster ingress controller.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ado2gh-web
  namespace: ado2gh
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
spec:
  rules:
    - host: ado2gh.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: web
                port:
                  number: 3000
